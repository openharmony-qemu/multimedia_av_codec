import("//build/ohos.gni")
import("//foundation/multimedia/av_codec/config.gni")

config("statistics_event_ipc_public_config") {
  include_dirs = [
    "$av_codec_root_dir/services/services/sa_avcodec/client",
    "$av_codec_root_dir/services/services/sa_avcodec/ipc",
    "$av_codec_root_dir/services/services/common/event_manager",
  ]
}

ohos_source_set("statistics_event_ipc") {
  branch_protector_ret = "pac_ret"
  public_configs = [ ":statistics_event_ipc_public_config" ]

  configs = [
    "$av_codec_root_dir/services/dfx:av_codec_service_log_dfx_public_config",
  ]

  sources = [
    "statistics_event_reporter.cpp",
    "../ipc/avcodec_parcel.cpp",
  ]

  include_dirs = [
    "$av_codec_root_dir/services/services/sa_avcodec/ipc",
    "$av_codec_root_dir/services/services/sa_avcodec/client",
    "$av_codec_root_dir/services/services/common",
    "$av_codec_root_dir/services/services/common/event_manager",
    "$av_codec_root_dir/services/dfx/include",
    "$av_codec_root_dir/services/utils/include",
    "$av_codec_root_dir/interfaces/inner_api/native",
  ]

  defines = av_codec_defines

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "media_foundation:media_foundation",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "multimedia"
  part_name = "av_codec"
}