import("//build/ohos.gni")
import("//foundation/multimedia/av_codec/config.gni")

config("smart_fluency_decoding_config") {
  include_dirs = [
    "./",
    "./interfaces",
    "./analyzers",
    "./strategies",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/interfaces/kits/c",
    "$av_codec_root_dir/services/dfx/include",
  ]
}

config("smart_fluency_decoding_public_config") {
  include_dirs = [
    "./",
    "./interfaces",
    "./strategies",
    "./analyzers",
  ]
}

ohos_source_set("smart_fluency_decoding") {
  branch_protector_ret = "pac_ret"
  sanitize = av_codec_sanitize

  cflags = [
    "-std=c++17",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wall",
    "-fno-common",
    "-fstack-protector-strong",
    "-Wshadow",
    "-FPIC",
    "-FS",
    "-O2",
    "-D_FORTIFY_SOURCE=2",
    "-fvisibility=hidden",
    "-Wformat=2",
    "-Wfloat-equal",
    "-Wdate-time",
    "-Werror",
    "-Wextra",
    "-Wimplicit-fallthrough",
    "-Wsign-compare",
    "-Wunused-parameter",
  ]

  configs = [ ":smart_fluency_decoding_config" ]
  public_configs = [ ":smart_fluency_decoding_public_config" ]

  sources = [
    "analyzers/nalu_analyzer_so_loader.cpp",
    "analyzers/mv_analyzer_so_loader.cpp",
    "strategies/retention_strategy_factory.cpp",
    "strategies/adaptive_retention_strategy.cpp",
    "strategies/auto_fallback_retention_strategy.cpp",
    "strategies/fixed_ratio_retention_strategy.cpp",
    "strategies/full_retention_strategy.cpp",
    "async_drop_dispatcher.cpp",
    "drop_sync_coordinator.cpp",
    "smart_fluency_decoding.cpp",
    "smart_fluency_decoding_builder.cpp",
    "smart_fluency_decoding_manager.cpp",
  ]

  deps = [
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
  ]

  external_deps = [
    "c_utils:utils",
    "graphic_surface:surface",
    "drivers_interface_display:libdisplay_commontype_proxy_2.2",
    "hilog:libhilog",
    "media_foundation:media_foundation",
  ]

  if (build_variant != "user") {
    defines = [ "SFD_DEBUG" ]
    sources += [ "smart_fluency_decoding_dumper.cpp" ]
    external_deps += [ "init:libbegetutil" ]
  }

  subsystem_name = "multimedia"
  part_name = "av_codec"
}
