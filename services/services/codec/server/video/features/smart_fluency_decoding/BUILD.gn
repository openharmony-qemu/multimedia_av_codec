import("//build/ohos.gni")
import("//foundation/multimedia/av_codec/config.gni")

config("smart_fluency_decoding_config") {
  include_dirs = [
    "./",
    "./include/",
    "./nalu_analyzer",
    "./frame_dropper",
    "./frame_dropper/impl",
    "./mv_parser",
    "./mv_parser/impl",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/interfaces/kits/c",
  ]
}

config("smart_fluency_decoding_public_config") {
  include_dirs = [
    "./",
    "./include/",
    "./nalu_analyzer",
    "./frame_dropper",
    "./mv_parser",
  ]
}

ohos_source_set("smart_fluency_decoding") {
  branch_protector_ret = "pac_ret"
  sanitize = av_codec_sanitize

  cflags = [
    "-std=c++17",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wall",
    "-fno-common",
    "-fstack-protector-strong",
    "-Wshadow",
    "-FPIC",
    "-FS",
    "-O2",
    "-D_FORTIFY_SOURCE=2",
    "-fvisibility=hidden",
    "-Wformat=2",
    "-Wfloat-equal",
    "-Wdate-time",
    "-Werror",
    "-Wextra",
    "-Wimplicit-fallthrough",
    "-Wsign-compare",
    #"-Wunused-parameter",
  ]

  configs = [ ":smart_fluency_decoding_config" ]
  public_configs = [ ":smart_fluency_decoding_public_config" ]

  sources = [
    "smart_fluency_decoding.cpp",
    "smart_fluency_decoding_builder.cpp",
    "smart_fluency_decoding_dumper.cpp",
    "async_drop_dispatcher.cpp",
    "frame_dropper/frame_dropper_factory.cpp",
    "drop_sync_coordinator.cpp",

    # MV解析模块 - 对外暴露的公共组件
    "mv_parser/mv_data.cpp",
    "mv_parser/mv_parser_factory.cpp",

    # MV解析模块 - impl/ 内部实现（物理隔离，外部不可见）
    "mv_parser/impl/mv_parser_base.cpp",
    "mv_parser/impl/avc_mv_parser.cpp",
    "mv_parser/impl/hevc_mv_parser.cpp",
    "mv_parser/impl/vvc_mv_parser.cpp",

    # NALU 码流分析层 (轻量级探针)
    "nalu_analyzer/nalu_analyzer_so_loader.cpp",

    # 丢帧器实现
    "frame_dropper/impl/uniform_fallback_dropper.cpp",
    "frame_dropper/impl/uniform_ratio_dropper.cpp",
    "frame_dropper/impl/passthrough_dropper.cpp",
  ]

  deps = [
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
  ]

  external_deps = [
    "c_utils:utils",
    "graphic_surface:surface",
    "drivers_interface_display:libdisplay_commontype_proxy_2.2",
    "hilog:libhilog",
    #"init:libbegetutil",
    "media_foundation:media_foundation", #media_foundation/interface/kits/c/native_averrors.h
  ]

  subsystem_name = "multimedia"
  part_name = "av_codec"
}
