import("//build/ohos.gni")
import("//foundation/multimedia/av_codec/config.gni")

ohos_shared_library("av_codec_ext_base") {
  defines = [
    "HST_ANY_WITH_NO_RTTI",
    "MEDIA_OHOS",
  ]
  defines += av_codec_defines
  branch_protector_ret = "pac_ret"
  cflags = [
    "-Wall",
    "-fno-exceptions",
    "-fno-common",
    "-fstack-protector-strong",
    "-Wshadow",
    "-FPIC",
    "-FS",
    "-O2",
    "-D_FORTIFY_SOURCE=2",
    "-fvisibility=hidden",
    "-Wformat=2",
    "-Wdate-time",
    "-Wextra",
    "-Wimplicit-fallthrough",
    "-Wsign-compare",
    "-Wunused-parameter",
    "-Wno-deprecated-declarations",
  ]

  sanitize = av_codec_sanitize

  include_dirs = [
    "$av_codec_root_dir/interfaces",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/services/dfx/include",
    "$av_codec_root_dir/services/media_engine/plugins/ffmpeg_adapter/audio_decoder/opus_base",
  ]

  sources = [
    "$av_codec_root_dir/services/media_engine/plugins/ffmpeg_adapter/audio_decoder/opus_base/opus_plugin_ext.cpp",
  ]

  deps = [
  ]

  external_deps = [
    "opus:opus_codec",
    "hilog:libhilog",
    "media_foundation:media_foundation",
  ]

  subsystem_name = "multimedia"
  part_name = "av_codec"
}