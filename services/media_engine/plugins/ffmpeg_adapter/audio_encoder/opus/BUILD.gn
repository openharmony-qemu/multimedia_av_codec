import("//build/ohos.gni")
import("//foundation/multimedia/av_codec/config.gni")

ohos_shared_library("media_plugin_OpusAudioEncoder") {
  install_enable = true
  defines = [
    "HST_ANY_WITH_NO_RTTI",
    "MEDIA_OHOS",
  ]
  defines += av_codec_defines 

  cflags = [
    "-fno-exceptions",
    "-Wall",
    "-fno-common",
    "-fstack-protector-all",
    "-Wshadow",
    "-FPIC",
    "-FS",
    "-O2",
    "-D_FORTIFY_SOURCE=2",
    "-Wformat=2",
    "-Wdate-time",
  ]

  cflags_cc = [
    "-std=c++17",
    "-fno-rtti",
  ]

  include_dirs = [
    "$av_codec_root_dir/interfaces",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/services/media_engine/plugins/ffmpeg_adapter/audio_encoder/opus",
    "$av_codec_root_dir/services/media_engine/plugins/ffmpeg_adapter/audio_decoder/opus_base",
  ]

  sanitize = av_codec_sanitize

  sources = [
    "$av_codec_root_dir/services/media_engine/plugins/ffmpeg_adapter/audio_encoder/opus/audio_opus_encoder_plugin.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/ffmpeg_adapter/audio_decoder/opus_base/opus_plugin_base.cpp",
  ]

  deps = []

  external_deps = [
    "opus:opus_codec",
    "c_utils:utils",
    "hilog:libhilog",
    "media_foundation:media_foundation",
  ]
  
  relative_install_dir = "media/media_plugins"
  subsystem_name = "multimedia"
  part_name = "av_codec"
}