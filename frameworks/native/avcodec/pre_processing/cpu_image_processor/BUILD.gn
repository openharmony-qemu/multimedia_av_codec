import("//build/ohos.gni")
import("//foundation/multimedia/av_codec/config.gni")

config("cpu_image_processor_public_config") {
  include_dirs = [ "." ]
}

ohos_source_set("cpu_image_processor") {
  branch_protector_ret = "pac_ret"
  sanitize = av_codec_sanitize

  public_configs = [ ":cpu_image_processor_public_config" ]

  include_dirs = [
    "$av_codec_root_dir/services/dfx/include",
    "$av_codec_root_dir/interfaces/inner_api/native",
  ]

  sources = [ "cpu_image_processor.cpp" ]

  deps = [ "$av_codec_root_dir/services/dfx:av_codec_service_dfx" ]

  external_deps = [
    "c_utils:utils",
    "graphic_surface:surface",
    "media_foundation:media_foundation",
  ]

  subsystem_name = "multimedia"
  part_name = "av_codec"
}
