import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")
module_output_path = "av_codec/av_codec"

ohos_fuzztest("VideoEncoderDualOutputFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file =
      "$av_codec_root_dir/test/fuzztest/video_encoder_dual_output_fuzzer"
  include_dirs = [
    "$av_codec_root_dir/interfaces/kits/c",
    "$av_codec_root_dir/test/fuzztest/video_encoder_dual_output_fuzzer",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [
    "video_enc_dual_output_sample.cpp",
    "video_encoder_dual_output_test.cpp",
  ]

  external_deps = [
    "bounds_checking_function:libsec_static",
    "graphic_surface:surface",
    "media_foundation:native_media_core",
    "window_manager:libwm",
  ]
  deps = [
    "$av_codec_root_dir/interfaces/kits/c:native_media_codecbase",
    "$av_codec_root_dir/interfaces/kits/c:native_media_venc",
  ]
}

group("fuzztest") {
  testonly = true
  deps = []

  deps += [ ":VideoEncoderDualOutputFuzzTest" ]
}
