#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
module_output_path = "av_codec/av_codec"
MEDIA_ROOT_DIR = "//foundation/multimedia/av_codec/"

##############################fuzztest##########################################
ohos_fuzztest("DemuxerPluginMpeg4FuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "$MEDIA_ROOT_DIR/test/fuzztest/demuxerpluginmpeg4_fuzzer"
  include_dirs = [
    "$MEDIA_ROOT_DIR/interfaces/kits/c",
    "$MEDIA_ROOT_DIR/test/fuzztest/demuxerpluginmpeg4_fuzzer",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/common",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/ffmpeg_demuxer",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [
    "mpeg4demuxerplugin_fuzzer.cpp",
    "mpeg4demuxerplugin_sample.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/avc_parser_impl.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/converter.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/demuxer_data_reader.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/demuxer_log_compressor.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/demuxer_utils.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/multi_stream_parser_manager.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/rbsp_context.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/reference_parser_manager.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/common/time_range_manager.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_audio_parser.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_box_parser.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_demuxer_plugin.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_demuxer_thread.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_format_checker.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_reference_parser.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_sample_helper.cpp",
    "$MEDIA_ROOT_DIR/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_sample_memory.cpp",
  ]
  external_deps = [
    "c_utils:utils",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "init:libbegetutil",
    "ipc:ipc_core",
    "media_foundation:native_media_core",
    "window_manager:libwm",
  ]
  deps = [
    "$MEDIA_ROOT_DIR/interfaces/inner_api/native:av_codec_client",
    "$MEDIA_ROOT_DIR/services/media_engine/modules:av_codec_media_engine_modules",
  ]
  resource_config_file =
      "$MEDIA_ROOT_DIR/test/moduletest/resources/ohos_test.xml"
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [ ":DemuxerPluginMpeg4FuzzTest" ]
}
###############################################################################

