import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")

module_output_path = "av_codec/AVCodec_Video/unittest"

group("pre_processing_unittest") {
  testonly = true
  deps = [
    ":fast_kits_interface_unittest",
    ":frame_drop_unittest",
  ]
}
config("pre_processing_unittest_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "./",
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing",
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/fast_kits_interface",
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/frame_drop",
    "$av_codec_root_dir/frameworks/native/capi/avcodec",
    "$av_codec_root_dir/services/dfx/include",
    "$av_codec_root_dir/services/services/common",
    "$av_codec_root_dir/services/services/common/event_manager",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/interfaces/kits/c",
  ]

  cflags = [
    "-std=c++17",
    "-fno-rtti",
    "-fexceptions",
    "-Dprivate=public",
    "-Dprotected=public",
  ]
  cflags_cc = cflags
  defines = av_codec_defines
}

ohos_unittest("frame_drop_unittest") {
  sanitize = av_codec_test_sanitize
  testonly = true
  module_out_path = module_output_path

  configs = [ ":pre_processing_unittest_config" ]

  sources = [ "frame_drop_unittest.cpp" ]

  deps = [
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/frame_drop:frame_drop",
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gmock_main",
    "hilog:libhilog",
    "media_foundation:media_foundation",
  ]

  subsystem_name = "multimedia"
  part_name = "av_codec"
}

ohos_unittest("fast_kits_interface_unittest") {
  sanitize = av_codec_test_sanitize
  testonly = true
  module_out_path = module_output_path

  configs = [ ":pre_processing_unittest_config" ]

  sources = [
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/fast_kits_interface/fast_kits_interface.cpp",
    "$av_codec_root_dir/frameworks/native/capi/avcodec/preprocessor.cpp",
    "fast_kits_interface_unittest.cpp",
  ]

  deps = [
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/frame_drop:frame_drop",
    "$av_codec_root_dir/interfaces/inner_api/native:av_codec_client",
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
  ]

  external_deps = [
    "c_utils:utils",
    "drivers_interface_display:libdisplay_commontype_proxy_1.0",
    "drivers_interface_display:libdisplay_commontype_proxy_2.2",
    "googletest:gmock_main",
    "graphic_surface:surface",
    "graphic_surface:sync_fence",
    "hilog:libhilog",
    "media_foundation:media_foundation",
    "media_foundation:native_media_core",
  ]

  resource_config_file =
      "$av_codec_root_dir/test/unittest/resources/ohos_test.xml"

  subsystem_name = "multimedia"
  part_name = "av_codec"
}
