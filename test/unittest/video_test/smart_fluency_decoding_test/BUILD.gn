import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")

module_output_path = "av_codec/AVCodec_Video/unittest"
sfd_root_dir = "$av_codec_root_dir/services/services/codec/server/video/features/smart_fluency_decoding"

av_codec_unittest_cflags = [
  "-std=c++17",
  "-fno-rtti",
  "-Wall",
  "-fno-common",
  "-fstack-protector-strong",
  "-Wshadow",
  "-FPIC",
  "-FS",
  "-O2",
  "-D_FORTIFY_SOURCE=2",
  "-fvisibility=hidden",
  "-Wformat=2",
  "-Wdate-time",
  "-Werror",
  "-Wextra",
  "-Wimplicit-fallthrough",
  "-Wsign-compare",
  "-Wno-unused-function",
  "-Wno-unused-parameter",
  "-Dprivate=public",
  "-Dprotected=public",
]

ohos_unittest("smart_fluency_decoding_unit_test") {
  sanitize = av_codec_test_sanitize
  module_out_path = module_output_path
  cflags = av_codec_unittest_cflags
  cflags_cc = cflags

  include_dirs = [
    "./",
    "$sfd_root_dir/",
    "$sfd_root_dir/analyzers",
    "$sfd_root_dir/interfaces",
    "$sfd_root_dir/strategies",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/interfaces/kits/c",
    "$av_codec_root_dir/services/utils/include",
    "$av_codec_root_dir/services/include",
    "$av_codec_root_dir/services/services/codec/server/video",
    "$av_codec_root_dir/services/services/common",
    "$av_codec_root_dir/services/services/common/event_manager",
  ]

  ldflags = [
    "-Wl,--wrap=dlopen",
    "-Wl,--wrap=dlsym",
    "-Wl,--wrap=dlclose",
  ]

  sources = [
    "$sfd_root_dir/drop_sync_coordinator.cpp",
    "$sfd_root_dir/smart_fluency_decoding.cpp",
    "$sfd_root_dir/smart_fluency_decoding_builder.cpp",
    "$sfd_root_dir/smart_fluency_decoding_manager.cpp",
    "$sfd_root_dir/smart_fluency_decoding_dumper.cpp",
    "$sfd_root_dir/async_drop_dispatcher.cpp",
    "$sfd_root_dir/strategies/retention_strategy_factory.cpp",
    "$sfd_root_dir/strategies/auto_fallback_retention_strategy.cpp",
    "$sfd_root_dir/strategies/fixed_ratio_retention_strategy.cpp",
    "$sfd_root_dir/strategies/adaptive_retention_strategy.cpp",
    "$sfd_root_dir/strategies/full_retention_strategy.cpp",
    "$sfd_root_dir/analyzers/mv_analyzer_so_loader.cpp",
    "$sfd_root_dir/analyzers/nalu_analyzer_so_loader.cpp",
    "$av_codec_root_dir/services/dfx/avcodec_dfx_component.cpp",

    "dlfcn_mock.cpp",
    "async_drop_dispatcher_test.cpp",
    "drop_sync_coordinator_test.cpp",
    "mv_analyzer_so_loader_test.cpp",
    "nalu_analyzer_so_loader_test.cpp",
    "retention_strategies_test.cpp",
    "smart_fluency_decoding_builder_test.cpp",
    "smart_fluency_decoding_manager_test.cpp",
    "smart_fluency_decoding_dumper_test.cpp",
    "smart_fluency_decoding_test.cpp",
  ]

  deps = [
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
    "$av_codec_root_dir/services/utils:av_codec_service_utils",
  ]

  external_deps = [
    "c_utils:utils",
    "drivers_interface_display:libdisplay_commontype_proxy_2.2",
    "googletest:gtest_main",
    "graphic_surface:surface",
    "hilog:libhilog",
    "media_foundation:media_foundation",
  ]
}

group("smart_fluency_decoding_test") {
  testonly = true
  deps = [ ":smart_fluency_decoding_unit_test" ]
}
