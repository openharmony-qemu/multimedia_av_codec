import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")

module_output_path = "av_codec/AVCodec_Video/unittest"
resource_configuration_file =
    "$av_codec_root_dir/test/unittest/resources/ohos_test.xml"

av_codec_unittest_cflags = [
  "-std=c++17",
  "-fno-rtti",
  "-Wall",
  "-fno-common",
  "-fstack-protector-strong",
  "-Wshadow",
  "-FPIC",
  "-FS",
  "-O2",
  "-D_FORTIFY_SOURCE=2",
  "-fvisibility=hidden",
  "-Wformat=2",
  "-Wdate-time",
  "-Werror",
  "-Wextra",
  "-Wimplicit-fallthrough",
  "-Wsign-compare",
  "-Wno-unused-function",
  "-Wno-unused-parameter",
  "-Dprivate=public",
  "-Dprotected=public",
]

public_include_dirs = [
  "./sample",
  "./sample/callback",
  "$av_codec_root_dir/interfaces/kits/c",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/common/codec_buffer_info",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/common/codec_buffer_queue",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/common/data_producer/avcc_reader",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/common/data_producer/base",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/common/utils",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/stable_sample/common/include",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/stable_sample/enviroment/include",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/stable_sample/sample/callback",
  "$av_codec_root_dir/test/unittest/video_test/vcodec_framework_test/stable_sample/sample/encoder/include",
  "$av_codec_root_dir/test/unittest/common",
  "$av_codec_root_dir/test/unittest/common/common_mock/avmemory/capi",
  "$av_codec_root_dir/test/unittest/common/common_mock/avmemory",
  "$av_codec_root_dir/test/unittest/common/common_mock/surface/capi",
  "$av_codec_root_dir/test/unittest/common/common_mock/surface",
  "$av_codec_root_dir/test/unittest/common/common_mock/avformat/capi",
  "$av_codec_root_dir/test/unittest/common/common_mock/avformat",
  "$av_codec_root_dir/test/unittest/common/common_mock/avbuffer/capi",
  "$av_codec_root_dir/test/unittest/common/common_mock/avbuffer",
  "$av_codec_root_dir/test/unittest/common/common_mock",
  "$av_codec_root_dir/frameworks/native/capi/common",
  "$av_codec_root_dir/interfaces/inner_api/native",
  "$av_codec_root_dir/interfaces/",
  "$av_codec_root_dir/services/dfx/include",
  "$av_codec_root_dir/services/utils/include",
]

group("videoenc_dualoutput_test") {
  testonly = true
  deps = [
    ":videoenc_dualoutput_coverage_test",
    ":videoenc_dualoutput_unit_test",
  ]
}

ohos_unittest("videoenc_dualoutput_unit_test") {
  sanitize = av_codec_test_sanitize
  module_out_path = module_output_path

  include_dirs = public_include_dirs

  cflags = av_codec_unittest_cflags

  sources = [
    "../vcodec_framework_test/common/codec_buffer_info/codec_buffer_info.cpp",
    "../vcodec_framework_test/common/codec_buffer_queue/codec_buffer_queue.cpp",
    "../vcodec_framework_test/common/utils/unittest_utils.cpp",
    "./sample/callback/sample_callback.cpp",
    "./sample/venc_dualoutput_sample.cpp",
    "./videoenc_dualoutput_unit_test.cpp",
  ]

  deps = [
    "$av_codec_root_dir/interfaces/inner_api/native:av_codec_client",
    "$av_codec_root_dir/interfaces/kits/c:capi_packages",
    "$av_codec_root_dir/interfaces/kits/c:native_media_codecbase",
    "$av_codec_root_dir/interfaces/kits/c:native_media_venc",
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
    "$av_codec_root_dir/services/utils:av_codec_service_utils",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "media_foundation:native_media_core",
    "openssl:libcrypto_shared",
    "window_manager:libwm",
  ]

  resource_config_file = resource_configuration_file

  subsystem_name = "multimedia"
  part_name = "av_codec"
}

ohos_unittest("videoenc_dualoutput_coverage_test") {
  sanitize = av_codec_test_sanitize
  module_out_path = module_output_path

  include_dirs = public_include_dirs
  include_dirs += [
    "$av_codec_root_dir/frameworks/native/capi/avcodec",
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/cpu_image_processor",
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/fast_kits_interface",
    "$av_codec_root_dir/frameworks/native/avcodec/pre_processing/frame_drop",
  ]

  cflags = av_codec_unittest_cflags

  sources = [
    "../vcodec_framework_test/common/codec_buffer_info/codec_buffer_info.cpp",
    "../vcodec_framework_test/common/codec_buffer_queue/codec_buffer_queue.cpp",
    "../vcodec_framework_test/common/utils/unittest_utils.cpp",
    "./sample/callback/sample_callback.cpp",
    "./sample/venc_dualoutput_sample.cpp",
    "./videoenc_dualoutput_coverage_test.cpp",
  ]

  deps = [
    "$av_codec_root_dir/interfaces/inner_api/native:av_codec_client",
    "$av_codec_root_dir/interfaces/kits/c:capi_packages",
    "$av_codec_root_dir/interfaces/kits/c:native_media_codecbase",
    "$av_codec_root_dir/interfaces/kits/c:native_media_venc",
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
    "$av_codec_root_dir/services/utils:av_codec_service_utils",
  ]

  external_deps = [
    "c_utils:utils",
    "drivers_interface_display:libdisplay_commontype_proxy_1.0",
    "drivers_interface_display:libdisplay_commontype_proxy_2.2",
    "graphic_surface:surface",
    "hilog:libhilog",
    "ipc:ipc_single",
    "media_foundation:native_media_core",
    "openssl:libcrypto_shared",
    "window_manager:libwm",
  ]

  resource_config_file = resource_configuration_file

  subsystem_name = "multimedia"
  part_name = "av_codec"
}
