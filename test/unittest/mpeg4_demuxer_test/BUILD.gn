import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")

module_output_path = "av_codec/AVCodec_Video/unittest"

mpeg4_demuxer_unittest_cflags = [
  "-std=c++17",
  "-fno-rtti",
  "-fno-exceptions",
  "-Wall",
  "-fno-common",
  "-fstack-protector-strong",
  "-Wshadow",
  "-FPIC",
  "-FS",
  "-O2",
  "-D_FORTIFY_SOURCE=2",
  "-fvisibility=hidden",
  "-Wformat=2",
  "-Wdate-time",
  "-Werror",
  "-Wextra",
  "-Wimplicit-fallthrough",
  "-Wsign-compare",
  "-Wunused-parameter",
  "-Dprivate=public",
  "-Dprotected=public",
]

#################################################################################################################
ohos_unittest("mpeg4_demuxer_capi_unit_test") {
  sanitize = av_codec_test_sanitize
  module_out_path = module_output_path
  testonly = true
  include_dirs = [
    "./",
    "./capi",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/interfaces/kits/c",
    "$av_codec_root_dir/frameworks/native/capi/common",
    "$av_codec_root_dir/test/unittest/format_test",
    "$av_codec_root_dir/test/unittest/format_test/capi",
    "$av_codec_root_dir/test/unittest/mpeg4_source_test",
    "$av_codec_root_dir/test/unittest/mpeg4_source_test/capi",
    "$av_codec_root_dir/test/unittest/common/common_mock",
    "$av_codec_root_dir/test/unittest/common/common_mock/avmemory",
    "$av_codec_root_dir/test/unittest/common/common_mock/avmemory/capi",
    "$av_codec_root_dir/test/nativedemo/include",
    "$av_codec_root_dir/test/nativedemo/avdemuxer/server_demo",
    "$av_codec_root_dir/test/unittest/common",
    "$av_codec_root_dir/services/utils/include",
    "$av_codec_root_dir/services/media_engine/modules/demuxer",
    "$av_codec_root_dir/test/unittest/mpeg4_demuxer_test"
  ]

  cflags = mpeg4_demuxer_unittest_cflags

  if (av_codec_support_demuxer) {
    sources = [
      "$av_codec_root_dir/test/nativedemo/avdemuxer/server_demo/file_server_demo.cpp",
      "$av_codec_root_dir/test/unittest/common/http_server_demo.cpp",
      "$av_codec_root_dir/test/unittest/mpeg4_source_test/capi/mpeg4_source_capi_mock.cpp",
      "$av_codec_root_dir/test/unittest/mpeg4_source_test/capi/mpeg4_source_capi_mock_factory.cpp",
      "./capi/mpeg4_demuxer_capi_mock.cpp",
      "./capi/mpeg4_demuxer_capi_mock_factory.cpp",
      "./mpeg4_demuxer_stream_unit_test.cpp",
      "./mpeg4_demuxer_unit_test.cpp",
      "./mpeg4_demuxer_uri_unit_test.cpp",
    ]
  }

  if (target_cpu == "arm64" || is_emulator) {
    av_codec_path = "\"/system/lib64\""
  } else {
    av_codec_path = "\"/system/lib\""
  }
  defines = [
    "AV_CODEC_PATH=${av_codec_path}",
    "MPEG4_DEMUXER_CAPI_UNIT_TEST",
  ]
  defines += av_codec_defines
  deps = [
    "$av_codec_root_dir/interfaces/kits/c:capi_packages",
    "$av_codec_root_dir/services/engine/base:av_codec_codec_base",
    "$av_codec_root_dir/services/media_engine/modules:av_codec_media_engine_modules",
    "$av_codec_root_dir/services/utils:av_codec_service_utils",
    "$av_codec_root_dir/test/unittest/common:av_codec_capi_unit_test"
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "init:libbegetutil",
    "media_foundation:media_foundation",
  ]
  if (av_codec_support_drm) {
    external_deps += [
      "drm_framework:drm_framework",
      "drm_framework:native_drm",
    ]
  }

  resource_config_file =
      "$av_codec_root_dir/test/unittest/resources/ohos_test.xml"
}

