import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")

module_output_path = "av_codec/player_framework/unittest"

interstitial_test_sources = [
  "$av_codec_root_dir/services/media_engine/modules/interstitial/interstitial_controller.cpp",
  "$av_codec_root_dir/services/media_engine/modules/interstitial/interstitial_scheduler.cpp",
  "$av_codec_root_dir/services/media_engine/modules/interstitial/interstitial_vod_strategies.cpp",
  "$av_codec_root_dir/services/media_engine/modules/interstitial/interstitial_live_strategies.cpp",
]

config("interstitial_unittest_cfg") {
  defines = [
    "HST_ANY_WITH_NO_RTTI",
    "MEDIA_OHOS",
    "TESTING",
  ]

  cflags = [
    "-Wno-sign-compare",
    "-fno-exceptions",
    "-fno-common",
    "-fstack-protector-all",
    "-Wshadow",
    "-FPIC",
    "-FS",
    "-O2",
    "-D_FORTIFY_SOURCE=2",
    "-Wformat=2",
    "-Wdate-time",
    "-Dprivate=public",
    "-Dprotected=public",
  ]

  cflags_cc = [
    "-std=c++17",
    "-fno-rtti",
  ]

  include_dirs = [
    "$av_codec_root_dir/interfaces",
    "$av_codec_root_dir/interfaces/inner_api",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/services/media_engine/modules",
    "$av_codec_root_dir/services/media_engine/modules/demuxer",
    "$av_codec_root_dir/services/media_engine/modules/interstitial",
    "$av_codec_root_dir/services/media_engine/plugins/source",
    "$av_codec_root_dir/test/unittest/common",
    "./mock",
  ]
}

#################################################################################################################
ohos_unittest("interstitial_controller_unittest") {
  sanitize = av_codec_test_sanitize
  module_out_path = module_output_path
  testonly = true
  configs = [
    ":interstitial_unittest_cfg",
    "$av_codec_root_dir/services/dfx:av_codec_service_log_dfx_public_config",
  ]
  sources = interstitial_test_sources + [
    "interstitial_controller_unittest.cpp",
  ]
  deps = [
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
    "$av_codec_root_dir/services/media_engine/modules:av_codec_media_engine_modules",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gmock_main",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "hisysevent:libhisysevent",
    "ipc:ipc_single",
    "media_foundation:media_foundation",
    "netmanager_base:net_conn_manager_if",
    "safwk:system_ability_fwk",
  ]
}

