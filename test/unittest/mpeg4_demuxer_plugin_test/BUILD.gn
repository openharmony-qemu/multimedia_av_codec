import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")

module_output_path = "av_codec/AVCodec_Video/unittest"

config("mpeg4_demuxer_plugin_test_cfg") {
  defines = [
    "HST_ANY_WITH_NO_RTTI",
    "MEDIA_OHOS",
    "TESTING",
  ]

  cflags = [
    "-Wno-sign-compare",
    "-fno-exceptions",
    "-fno-common",
    "-fstack-protector-all",
    "-Wshadow",
    "-FPIC",
    "-FS",
    "-O2",
    "-D_FORTIFY_SOURCE=2",
    "-Wformat=2",
    "-Wdate-time",
    "-Dprivate=public",
    "-Dprotected=public",
    "-Wno-unused-parameter",
  ]

  cflags_cc = [
    "-std=c++17",
    "-fno-rtti",
  ]

  include_dirs = [
    "$av_codec_root_dir/interfaces",
    "$av_codec_root_dir/interfaces/inner_api",
    "$av_codec_root_dir/interfaces/inner_api/native",
    "$av_codec_root_dir/interfaces/kits/c",
    "$av_codec_root_dir/services/media_engine/modules",
    "$av_codec_root_dir/services/media_engine/modules/demuxer",
    "$av_codec_root_dir/services/media_engine/modules/source",
    "$av_codec_root_dir/services/media_engine/plugins/common",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/mpeg4_demuxer",
    "$av_codec_root_dir/services/media_engine/plugins/ffmpeg_adapter/common",
    "$av_codec_root_dir/test/nativedemo/include",
  ]
}

ohos_unittest("mpeg4_demuxer_plugin_unit_test") {
  sanitize = av_codec_test_sanitize
  module_out_path = module_output_path
  testonly = true

  configs = [
    ":mpeg4_demuxer_plugin_test_cfg",
    "$av_codec_root_dir/services/dfx:av_codec_service_log_dfx_public_config",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer:demuxer_config",
  ]

  sources = [
    "$av_codec_root_dir/services/media_engine/modules/demuxer/base_stream_demuxer.cpp",
    "$av_codec_root_dir/services/media_engine/modules/demuxer/demuxer_plugin_manager.cpp",
    "$av_codec_root_dir/services/media_engine/modules/demuxer/stream_demuxer.cpp",
    "$av_codec_root_dir/services/media_engine/modules/demuxer/type_finder.cpp",
    "$av_codec_root_dir/services/media_engine/modules/source/source.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common/avc_parser_impl.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common/converter.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common/demuxer_data_reader.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common/demuxer_log_compressor.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common/multi_stream_parser_manager.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common/rbsp_context.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/common/reference_parser_manager.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_audio_parser.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_box_parser.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_demuxer_plugin.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_demuxer_thread.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_reference_parser.cpp",
    "$av_codec_root_dir/services/media_engine/plugins/demuxer/mpeg4_demuxer/mpeg4_sample_helper.cpp",
    "mpeg4_demuxer_plugin_unit_test.cpp",
  ]

  deps = [
    "$av_codec_root_dir/services/dfx:av_codec_service_dfx",
    "$av_codec_root_dir/services/engine/base:av_codec_codec_base",
  ]

  external_deps = [
    "c_utils:utils",
    "ffmpeg:libohosffmpeg",
    "graphic_surface:surface",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_single",
    "media_foundation:media_foundation",
  ]

  resource_config_file =
      "$av_codec_root_dir/test/unittest/resources/ohos_test.xml"
}
