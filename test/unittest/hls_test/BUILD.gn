import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")
import("//foundation/multimedia/av_codec/test/unittest/http_source_test.gni")

module_output_path = "av_codec/stream_player_framework"

hls_test_sources = http_source_ut_hls_core_sources
# NOSORT
hls_test_sources +=
    [ "$av_codec_root_dir/test/unittest/common/http_server_demo.cpp" ]
hls_test_sources += http_source_ut_http_media_string_utils_sources

config("hls_unittest_cfg") {
  defines = http_source_ut_hls_defines
  cflags = http_source_ut_hls_cflags
  cflags_cc = http_source_ut_hls_cflags_cc
  include_dirs = http_source_ut_hls_include_dirs
}

ohos_unittest("hls_media_downloader_unit_test") {
  sanitize = av_codec_test_sanitize
  module_out_path = module_output_path
  testonly = true
  defines = [ "AVCODEC_TEST_HTTP_PORT=46674" ]
  configs = [
    ":hls_unittest_cfg",
    "$av_codec_root_dir/services/dfx:av_codec_service_log_dfx_public_config",
  ]
  sources = hls_test_sources + [ "hls_media_downloader_unit_test.cpp" ]
  deps = http_source_ut_deps

  external_deps = http_source_ut_hls_external_deps
  resource_config_file =
      "$av_codec_root_dir/test/unittest/resources/ohos_test.xml"
}

