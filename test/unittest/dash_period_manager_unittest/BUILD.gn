import("//build/test.gni")
import("//foundation/multimedia/av_codec/config.gni")
import("//foundation/multimedia/av_codec/test/unittest/http_source_test.gni")

module_output_path = "av_codec/stream_player_framework"
dash_test_sources = http_source_ut_dash_core_sources
# NOSORT
dash_test_sources +=
    [ "$av_codec_root_dir/test/unittest/common/http_server_demo.cpp" ]
dash_test_sources += http_source_ut_string_utils_sources
config("dash_unittest_cfg") {
  defines = http_source_ut_dash_defines
  cflags = http_source_ut_dash_cflags
  cflags_cc = http_source_ut_dash_cflags_cc
  include_dirs = http_source_ut_dash_include_dirs
}

ohos_unittest("dash_period_manager_unit_test") {
  module_out_path = module_output_path
  testonly = true
  configs = [
    ":dash_unittest_cfg",
    "$av_codec_root_dir/services/dfx:av_codec_service_log_dfx_public_config",
  ]
  sources = dash_test_sources + [ "dash_period_manager_unit_test.cpp" ]
  deps = http_source_ut_deps

  external_deps = http_source_ut_external_deps
}
